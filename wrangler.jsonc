{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard.
  "name": "next-read",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Run the Worker first for the API; everything else is served straight from public/.
    "run_worker_first": ["/api/*"]
  }
  // Secrets (set in the dashboard or with `wrangler secret put`): ANTHROPIC_API_KEY, APP_PASSCODE
}
