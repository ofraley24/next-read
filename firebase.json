{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/api/**", "function": { "functionId": "api", "region": "europe-west2" } }
    ]
  },
  "functions": [
    { "source": "functions", "codebase": "default", "ignore": ["node_modules", ".git", "test"] }
  ]
}
